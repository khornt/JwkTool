<Window x:Class="JwkTool2.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:JwkTool2.ViewModels"
                
        ResizeMode="NoResize"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JwkTool2"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="580">

    <Window.Resources>
        <Style x:Key="PurpleHoverButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2E"/>
            <!-- Dark gray -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44D9EF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2299BB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Margin="0" 
                                  
                                  x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/PemBackground.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Content="Jwk Creater Tool" FontSize="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"
               Foreground="White" />

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Enter Certificate KID:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
               Foreground="White" />

        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="txtKid" Text="{Binding Kid, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" 
            TextAlignment="Left" VerticalAlignment="Top" Height="25" Width="250" Margin="15,0,0,0"
            Background="#333333" Padding="5,3,2,0" Foreground="White" BorderBrush="#555555"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Select Rsa key:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"
            Foreground="White"/>

        <ComboBox Background="White" Foreground="Black"
           Grid.Row="4"
           Grid.Column="0"
           FontSize="14"
           ItemsSource="{Binding AlgorithmDropDown}"  
           SelectedValue="{Binding Algorithm, NotifyOnTargetUpdated=True}"
           Name="DropDownList" HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Width="120" Margin="15,0,0,0">

            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                </Style>
            </ComboBox.ItemContainerStyle>

            <ComboBox.Resources>
                <!--Colour of ComboBoxItem-->
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="Black" />
                <!--Mouse over colour of ComboBoxItem-->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Black" />
            </ComboBox.Resources>
        </ComboBox>


        <Button 
            Style="{StaticResource PurpleHoverButton}"
            Grid.Row="5"
            Grid.Column="0"
            Padding="5" Width="140" Height="40"
            Content="Select Public PEM" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
            Command="{Binding SelectFileCommand}"                            
            FontSize="14" FontWeight="Bold"/>

        <Button 
            Style="{StaticResource PurpleHoverButton}"
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="5" Width="170" Height="40"
            Content="Import from Certificate" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"
            Command="{Binding SelectCertificateCommand}"                            
            FontSize="12" FontWeight="Bold"/>

        <Label Grid.Row="6"  Grid.Column="0" Grid.ColumnSpan="2"
            Name="FileLabel" FontSize="16" FontWeight="Bold"
            Content="{Binding FileLabel, UpdateSourceTrigger=PropertyChanged}"  
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0" Width="350"
            Foreground="White"/>

        <TextBox Grid.Row="7"
          Grid.ColumnSpan="3"
          Name="txtJwk" Text="{Binding Jwk, UpdateSourceTrigger=PropertyChanged}" 
          HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap"
          IsReadOnly="true" VerticalAlignment="Top" Height="230" Width="500" Margin="20,0,0,0"
          Background="#801E1E1E" Padding="5,3,2,0" Foreground="White" BorderBrush="#555555" />





        <Button 
            Style="{StaticResource PurpleHoverButton}"
            Grid.Row="8"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Width="170" Height="40"
            Content="Create JWK file" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
            Command="{Binding CreateJwkFileCommand}"                            
            FontSize="12" FontWeight="Bold"/>





        <!--<Button Grid.Row="8"
             Grid.Column="0"
             Content="Create JWK file" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,20,0,0"
             Command="{Binding CreateJwkFileCommand}"
             Padding="5" Width="110" Height="30"
             Background="Black" Foreground="White"
             FontSize="12" FontWeight="Bold"
             BorderThickness="0" BorderBrush="#666666"/>-->

      
    </Grid>
</Window>
